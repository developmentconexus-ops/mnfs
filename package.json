{
  "name": "mnfs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.18.0"
  },
  "bin": {
    "mnfs": "./bin/mnfs.mjs"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit",
    "test:unit": "npm run build --silent && node scripts/run-tests.mjs",
    "verify": "npm run typecheck && npm run test:unit",
    "doctor": "npm run build --silent && node bin/mnfs.mjs doctor"
  },
  "devDependencies": {
    "@types/node": "24.12.4",
    "typescript": "5.9.3"
  }
}
