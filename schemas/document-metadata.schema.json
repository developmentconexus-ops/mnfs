{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mnfs.local/schemas/document-metadata.schema.json",
  "title": "MNFS document metadata",
  "type": "object",
  "required": [
    "id",
    "title",
    "document_type",
    "authority",
    "status",
    "owners"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 3
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "document_type": {
      "type": "string",
      "minLength": 1
    },
    "form": {
      "enum": [
        "tutorial",
        "how_to",
        "reference",
        "explanation"
      ]
    },
    "authority": {
      "enum": [
        "constitutional",
        "decision",
        "specification",
        "contract",
        "standard_policy",
        "policy",
        "reference",
        "guidance",
        "evidence",
        "tracking",
        "research_historical",
        "generated_projection"
      ]
    },
    "status": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string"
    },
    "owners": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "approvers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "related": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "supersedes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "superseded_by": {
      "type": [
        "string",
        "null"
      ]
    },
    "tracking_issue": {
      "type": [
        "integer",
        "string"
      ]
    }
  },
  "additionalProperties": true
}
