#!/usr/bin/env node

(async () => {
  const { appendFileSync, realpathSync } = await import('node:fs');
  const { spawnSync } = await import('node:child_process');
  const { isAbsolute } = await import('node:path');

  const realGit = process.env.TC01_REAL_GIT;
  const logPath = process.env.TC01_GIT_LOG;

  function fail(message) {
    process.stderr.write(`${message}\n`);
    process.exit(2);
  }

  if (typeof realGit !== 'string' || !isAbsolute(realGit)) {
    fail('TC01_REAL_GIT must be an absolute path.');
  }
  if (typeof logPath !== 'string' || !isAbsolute(logPath)) {
    fail('TC01_GIT_LOG must be an absolute path.');
  }

  const argv = process.argv.slice(2);
  const cwd = realpathSync(process.cwd());
  const entry = { schemaVersion: 1, argv, cwd };

  try {
    appendFileSync(logPath, `${JSON.stringify(entry)}\n`, { encoding: 'utf8', flag: 'a' });
  } catch (error) {
    fail(`Unable to append TC-01 Git log: ${error instanceof Error ? error.message : String(error)}`);
  }

  const result = spawnSync(realGit, argv, {
    cwd,
    env: process.env,
    stdio: 'inherit',
    shell: false,
  });

  if (result.error) {
    process.stderr.write(`Unable to execute TC01_REAL_GIT: ${result.error.message}\n`);
    process.exit(127);
  }
  if (result.status !== null) {
    process.exit(result.status);
  }
  process.stderr.write(`TC01_REAL_GIT terminated by signal ${result.signal ?? 'unknown'}.\n`);
  process.exit(128);
})().catch((error) => {
  process.stderr.write(`TC-01 Git wrapper failed: ${error instanceof Error ? error.message : String(error)}\n`);
  process.exit(2);
});
