{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mnfs.local/schemas/document-metadata.schema.json",
  "title": "MNFS document metadata",
  "type": "object",
  "required": [
    "id",
    "title",
    "document_type",
    "authority",
    "status",
    "owners"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 3,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "document_type": {
      "type": "string",
      "minLength": 1
    },
    "form": {
      "enum": [
        "tutorial",
        "how_to",
        "reference",
        "explanation"
      ]
    },
    "authority": {
      "enum": [
        "constitutional",
        "decision",
        "specification",
        "contract",
        "standard_policy",
        "policy",
        "reference",
        "guidance",
        "evidence",
        "tracking",
        "research_historical",
        "generated_projection"
      ]
    },
    "status": {
      "enum": [
        "draft",
        "proposed",
        "accepted",
        "rejected",
        "superseded",
        "deprecated",
        "implementing",
        "implemented",
        "deferred",
        "withdrawn",
        "candidate",
        "pilot",
        "ratified",
        "enforced",
        "active",
        "retired",
        "published",
        "historical",
        "current",
        "completed",
        "archived",
        "generated",
        "review_required",
        "stale",
        "unknown"
      ]
    },
    "version": {
      "type": "string"
    },
    "owners": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "approvers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "related": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "supersedes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "superseded_by": {
      "type": [
        "string",
        "null"
      ]
    },
    "generated_from": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "source_manifest": {
      "type": "string",
      "minLength": 1
    },
    "source_of_truth_for": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "review_triggers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "last_reviewed": {
      "type": "string"
    },
    "tracking_issue": {
      "type": [
        "integer",
        "string"
      ]
    }
  },
  "additionalProperties": true
}
