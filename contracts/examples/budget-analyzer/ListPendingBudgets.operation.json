{
  "schemaVersion": "project-operation/v1",
  "operationId": "ListPendingBudgets",
  "regime": "QUERY",
  "inputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "filters": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "sellerIds": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "customerIds": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "agingBands": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "enum": ["AGE_0_3", "AGE_4_7", "AGE_8_30", "AGE_31_PLUS"]
            }
          },
          "calendarMonths": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$"
            }
          },
          "sourceCompanyIds": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      },
      "pageToken": {
        "type": "string",
        "minLength": 1,
        "description": "Opaque continuation token only; it is not authorization or historical snapshot authority."
      }
    }
  },
  "outputSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "required": ["truth"],
    "properties": {
      "truth": {
        "type": "object",
        "additionalProperties": false,
        "required": ["state", "asOf", "freshness", "coverage", "provenance"],
        "properties": {
          "state": {
            "enum": [
              "SUPPORTED_CURRENT",
              "SUPPORTED_STALE",
              "PARTIAL",
              "UNVERIFIED",
              "INDETERMINATE",
              "UNSUPPORTED",
              "DEPENDENCY_UNAVAILABLE"
            ]
          },
          "asOf": {
            "type": "string",
            "minLength": 1,
            "readOnly": true,
            "description": "Opaque system-issued source/reconciliation coordinate for this page; never caller-selected historical input."
          },
          "freshness": { "enum": ["CURRENT", "STALE", "UNKNOWN"] },
          "coverage": { "enum": ["COMPLETE", "PARTIAL", "UNKNOWN"] },
          "provenance": { "enum": ["VERIFIED", "PARTIAL", "UNVERIFIED"] }
        }
      },
      "items": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "budgetRef",
            "canonicalBusinessDate",
            "budgetAgeDays",
            "budgetValue",
            "sellerId",
            "customerId",
            "sourceCompanyId",
            "pendingEvidenceState"
          ],
          "properties": {
            "budgetRef": {
              "type": "string",
              "minLength": 1,
              "description": "Exact source-qualified Budget document identity."
            },
            "canonicalBusinessDate": { "type": "string", "format": "date" },
            "lastChangeAt": { "type": "string", "format": "date-time", "readOnly": true },
            "budgetAgeDays": {
              "type": "integer",
              "description": "May be negative only when the response truth state is PARTIAL/UNVERIFIED/INDETERMINATE; negative age is never banded."
            },
            "agingBand": {
              "enum": ["AGE_0_3", "AGE_4_7", "AGE_8_30", "AGE_31_PLUS"]
            },
            "budgetValue": { "type": "string", "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$" },
            "sellerId": { "type": "string", "minLength": 1 },
            "sellerName": { "type": "string", "minLength": 1 },
            "customerId": { "type": "string", "minLength": 1 },
            "customerName": { "type": "string", "minLength": 1 },
            "sourceCompanyId": { "type": "string", "minLength": 1 },
            "pendingEvidenceState": { "enum": ["CONFIRMED", "AMBIGUOUS", "UNVERIFIED"] }
          }
        }
      },
      "nextPageToken": {
        "type": "string",
        "minLength": 1,
        "readOnly": true,
        "description": "Opaque continuation for the next page. It does not pin or authorize a historical snapshot."
      }
    },
    "allOf": [
      {
        "if": {
          "properties": {
            "truth": {
              "properties": {
                "state": { "enum": ["SUPPORTED_CURRENT", "SUPPORTED_STALE"] }
              },
              "required": ["state"]
            }
          },
          "required": ["truth"]
        },
        "then": {
          "required": ["items"],
          "properties": {
            "items": {
              "items": {
                "required": ["agingBand"],
                "properties": {
                  "budgetAgeDays": { "minimum": 0 }
                }
              }
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "truth": {
              "properties": {
                "state": { "enum": ["UNVERIFIED", "INDETERMINATE", "UNSUPPORTED", "DEPENDENCY_UNAVAILABLE"] }
              },
              "required": ["state"]
            }
          },
          "required": ["truth"]
        },
        "then": {
          "not": { "required": ["items"] }
        }
      }
    ]
  },
  "callers": [
    {
      "kind": "PUBLISHED_APP",
      "roles": ["admin", "member"]
    }
  ],
  "scope": {
    "workspace": "CURRENT_WORKSPACE",
    "project": "CURRENT_PROJECT",
    "publishedApp": "CURRENT_PROJECT_APP"
  },
  "requiredPins": [
    "ACTIVE_RELEASE",
    "PROJECT_BRAIN_BINDING",
    "PROJECT_CONNECTION_BINDING",
    "CONNECTION_REVISION"
  ],
  "effectClass": "READ_ONLY",
  "outcomeProfile": "ANALYTIC",
  "icProfiles": ["IC0"],
  "proof": {
    "positiveCaseId": "budget-analyzer-r6-page-with-system-coordinate",
    "negativeControlId": "budget-analyzer-negative-age-never-banded"
  }
}
