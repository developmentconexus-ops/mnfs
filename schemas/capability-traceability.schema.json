{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mnfs.local/schemas/capability-traceability.schema.json",
  "title": "MNFS capability traceability",
  "type": "object",
  "required": ["schemaVersion", "capabilityId", "capabilityVersion", "baseline", "applicability", "requirements", "readiness"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "capabilityId": { "type": "string", "pattern": "^CAP-[A-Z0-9-]+$" },
    "capabilityVersion": { "type": "string", "minLength": 1 },
    "baseline": {
      "type": "object",
      "required": ["blueprint", "roadmap", "adrs", "missionContract"],
      "properties": {
        "blueprint": { "$ref": "#/$defs/documentBinding" },
        "roadmap": { "$ref": "#/$defs/documentBinding" },
        "adrs": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "missionContract": {
          "type": "object",
          "required": ["missionId", "currentRevision", "status"],
          "properties": {
            "missionId": { "type": "string", "pattern": "^MIS-[0-9]{3,}$" },
            "currentRevision": { "type": "integer" },
            "status": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "applicability": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["domain", "state", "rationale", "requiredOutput"],
        "properties": {
          "domain": { "type": "string", "minLength": 1 },
          "state": { "enum": ["UNASSESSED", "APPLICABLE", "DEFERRED", "NOT_APPLICABLE", "BLOCKED", "SUPERSEDED"] },
          "rationale": { "type": "string", "minLength": 1 },
          "requiredOutput": { "type": "string", "minLength": 1 },
          "deferredTo": { "type": "string", "pattern": "^M[0-9]+$" }
        },
        "additionalProperties": false
      }
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "class", "statement", "level", "source", "proposedAllocation", "allocatedTo", "realizedBy", "verifiedBy", "evidencedBy", "state", "blockers"],
        "properties": {
          "id": { "type": "string", "pattern": "^CAP-[A-Z0-9-]+-REQ-[0-9]{3}$" },
          "class": { "type": "string", "minLength": 1 },
          "statement": { "type": "string", "minLength": 1 },
          "level": { "enum": ["MUST", "SHOULD", "MAY"] },
          "source": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "proposedAllocation": { "type": "array", "items": { "type": "string" } },
          "allocatedTo": { "type": "array", "items": { "type": "string" } },
          "realizedBy": { "type": "array", "items": { "type": "string" } },
          "verifiedBy": { "type": "array", "items": { "type": "string" } },
          "evidencedBy": { "type": "array", "items": { "type": "string" } },
          "state": { "enum": ["UNASSESSED", "APPLICABLE", "ALLOCATED", "DESIGNED", "IMPLEMENTED", "VERIFIED", "VALIDATED", "DEFERRED", "NOT_APPLICABLE", "BLOCKED", "SUPERSEDED"] },
          "blockers": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": false
      }
    },
    "readiness": {
      "type": "object",
      "required": ["R3", "R4", "R5", "R6", "R7", "R8"],
      "properties": {
        "R3": { "$ref": "#/$defs/readinessDisposition" },
        "R4": { "$ref": "#/$defs/readinessDisposition" },
        "R5": { "$ref": "#/$defs/readinessDisposition" },
        "R6": { "$ref": "#/$defs/readinessDisposition" },
        "R7": { "$ref": "#/$defs/readinessDisposition" },
        "R8": { "$ref": "#/$defs/readinessDisposition" }
      },
      "additionalProperties": false
    },
    "blockingItems": { "type": "array", "items": { "type": "object" } },
    "nextSequence": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "documentBinding": {
      "type": "object",
      "required": ["documentId", "version"],
      "properties": {
        "documentId": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "readinessDisposition": {
      "type": "object",
      "required": ["result", "reason"],
      "properties": {
        "result": { "enum": ["PASS", "REVIEW_REQUIRED", "BLOCKED", "NOT_STARTED", "FAIL"] },
        "reason": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
