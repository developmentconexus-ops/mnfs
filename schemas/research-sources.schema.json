{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mnfs.local/schemas/research-sources.schema.json",
  "title": "MNFS research source manifest",
  "type": "object",
  "required": ["schemaVersion", "reportId", "asOf", "sources"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "reportId": { "type": "string", "minLength": 3 },
    "asOf": { "type": "string", "minLength": 10 },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "url", "kind", "supports"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "url": { "type": "string", "pattern": "^https://" },
          "kind": { "enum": ["official_docs", "repository", "standard", "research", "benchmark", "product_docs"] },
          "version": { "type": "string" },
          "accessed": { "type": "string" },
          "supports": { "type": "array", "minItems": 1, "items": { "type": "string" } }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
