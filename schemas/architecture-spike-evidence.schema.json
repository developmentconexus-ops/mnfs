{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mnfs.local/schemas/architecture-spike-evidence.schema.json",
  "title": "MNFS Architecture Spike Evidence",
  "type": "object",
  "required": [
    "schemaVersion",
    "spikeId",
    "contractVersion",
    "runId",
    "startedAt",
    "finishedAt",
    "canonicalHost",
    "source",
    "candidate",
    "criteria",
    "rawArtifacts",
    "limitations",
    "measurements",
    "verdictInput"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "spikeId": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9-]{2,63}$"
    },
    "contractVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][A-Za-z0-9.-]+)?$"
    },
    "runId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"
    },
    "startedAt": {
      "type": "string",
      "minLength": 20
    },
    "finishedAt": {
      "type": "string",
      "minLength": 20
    },
    "canonicalHost": {
      "$ref": "#/$defs/host"
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "candidate": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "id",
        "provenance"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        }
      },
      "additionalProperties": false
    },
    "criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/criterion"
      }
    },
    "rawArtifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/artifact"
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "measurements": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/measurement"
      }
    },
    "verdictInput": {
      "$ref": "#/$defs/verdictInput"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "host": {
      "type": "object",
      "required": [
        "kind",
        "identity"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "identity": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "required": [
        "commitSha",
        "treeSha"
      ],
      "properties": {
        "commitSha": {
          "type": "string",
          "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
        },
        "treeSha": {
          "type": "string",
          "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
        }
      },
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "required": [
        "source",
        "versionOrCommit",
        "license",
        "publicBoundary"
      ],
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1
        },
        "versionOrCommit": {
          "type": "string",
          "minLength": 1
        },
        "license": {
          "type": "string",
          "minLength": 1
        },
        "publicBoundary": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "criterion": {
      "type": "object",
      "required": [
        "id",
        "required",
        "result",
        "artifactRefs"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "required": {
          "type": "boolean"
        },
        "result": {
          "enum": [
            "PASS",
            "FAIL",
            "BLOCKED",
            "UNKNOWN"
          ]
        },
        "artifactRefs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    },
    "artifact": {
      "type": "object",
      "required": [
        "id",
        "path",
        "sha256",
        "sizeBytes"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "sizeBytes": {
          "type": "integer"
        }
      },
      "additionalProperties": false
    },
    "measurement": {
      "type": "object",
      "required": [
        "id",
        "value",
        "unit",
        "artifactRefs"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": [
            "number",
            "string",
            "boolean"
          ]
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "artifactRefs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    },
    "verdictInput": {
      "type": "object",
      "required": [
        "status",
        "reasons"
      ],
      "properties": {
        "status": {
          "enum": [
            "PASS",
            "FAIL",
            "BLOCKED",
            "UNKNOWN"
          ]
        },
        "reasons": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    }
  }
}
